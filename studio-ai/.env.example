# Lumpli — variáveis de ambiente. Copie para .env (NUNCA versionado).
# Segredos ficam apenas no servidor (hospedagem da API / cofre de segredos). O app só recebe valores públicos.

# --- App mobile (públicas; o prefixo EXPO_PUBLIC_ embute o valor no app) ---
EXPO_PUBLIC_API_URL=http://127.0.0.1:8787
# Preenchidas quando o projeto Supabase existir (chave anon é pública por design; protegida por RLS):
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# --- API (apps/api) — SECRETAS, somente no servidor ---
DATA_DRIVER=supabase-rest          # supabase-rest (HTTPS, recomendado em nuvem) | postgres (local/VM)
DATABASE_URL=                      # só para DATA_DRIVER=postgres
SUPABASE_ANON_KEY=                 # chave pública (anon/publishable)
SUPABASE_URL=                      # https://<ref>.supabase.co (JWKS para validar sessões)
SUPABASE_SERVICE_ROLE_KEY=         # somente servidor; nunca no app, logs ou repositório
SUPABASE_JWT_SECRET=               # apenas projetos com segredo JWT legado (HS256)
STORAGE_DRIVER=supabase            # supabase | local (desenvolvimento)
STORAGE_BUCKET=studio-private
CORS_ORIGINS=                      # origens web permitidas, separadas por vírgula
PORT=8787

# --- Somente desenvolvimento local (scripts/dev-local.sh gera estes valores sozinho) ---
# DEV_AUTH=true                    # recusado pelo servidor se STORAGE_DRIVER=supabase
# LOCAL_STORAGE_DIR=.local-storage
# LOCAL_URL_SECRET=

# --- Etapa 0.3 ---
ANTHROPIC_API_KEY=
