# Studio AI — variáveis de ambiente (NÃO são necessárias na Etapa 1)
# Copie para .env (nunca versionado). Segredos ficam apenas no servidor.

# --- App mobile (públicas; prefixo EXPO_PUBLIC_ fica embutido no app) — Etapa 0.2
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_API_URL=

# --- API e worker (secretas) — Etapa 0.2/0.3
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=
STORAGE_BUCKET=studio-private
REDIS_URL=                 # opcional; sem ele a fila usa o Postgres
ANTHROPIC_API_KEY=         # provedor de IA (Etapa 0.3)
AI_DEFAULT_PROJECT_BUDGET_CENTS=200
